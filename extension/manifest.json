{
  "manifest_version": 3,
  "name": "Commenti per idealista",
  "short_name": "Commenti",
  "version": "1.0.0",
  "description": "Commenti, risposte, reazioni, GIF e immagini sotto gli annunci di idealista, con il tuo profilo Chrome. Non affiliato a idealista.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["identity", "storage"],
  "host_permissions": [
    "https://*.googleusercontent.com/*",
    "https://*.giphy.com/*"
  ],
  "oauth2": {
    "client_id": "740197553369-l64p9r56ij3kd4b6ra0btuaim13q14qi.apps.googleusercontent.com",
    "scopes": ["openid", "profile"]
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.idealista.it/*",
        "https://www.idealista.com/*",
        "https://www.idealista.pt/*"
      ],
      "js": ["styles.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Commenti per idealista",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_page": "popup.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
